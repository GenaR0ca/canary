diff --git a/src/database/create_character.go b/src/database/create_character.go
new file mode 100644
index 0000000..f97dce5
--- /dev/null
+++ b/src/database/create_character.go
@@ -0,0 +1,188 @@
+package database
+
+// Mubia Online: crear personajes desde el cliente (pantalla "Create" estilo MU).
+// El personaje nuevo es una copia del "<Clase> Sample" de esa vocación, con otro nombre y cuenta.
+
+import (
+	"database/sql"
+	"errors"
+	"fmt"
+	"regexp"
+	"strings"
+)
+
+// MaxCharactersPerAccount es el máximo de personajes por cuenta (como en MU).
+const MaxCharactersPerAccount = 5
+
+// CreatableVocations son las clases que se pueden crear (id de vocations.xml).
+var CreatableVocations = map[uint32]string{
+	1:  "Dark Wizard",
+	3:  "Fairy Elf",
+	4:  "Dark Knight",
+	11: "Magic Gladiator",
+	12: "Dark Lord",
+	13: "Summoner",
+	15: "Rage Fighter",
+}
+
+// CreateCharacterError es un error que se le muestra tal cual al jugador.
+type CreateCharacterError struct {
+	Message string
+}
+
+func (e *CreateCharacterError) Error() string { return e.Message }
+
+func userError(format string, args ...interface{}) error {
+	return &CreateCharacterError{Message: fmt.Sprintf(format, args...)}
+}
+
+var nameRegexp = regexp.MustCompile(`^[A-Za-z]+( [A-Za-z]+)*$`)
+var forbiddenWords = []string{"sample", "god", "gm", "cm", "admin", "gamemaster", "tutor", "staff"}
+
+// NormalizeCharacterName valida el nombre y lo deja con mayúscula en cada palabra.
+func NormalizeCharacterName(raw string) (string, error) {
+	name := strings.Join(strings.Fields(raw), " ")
+	if len(name) < 3 || len(name) > 20 {
+		return "", userError("El nombre debe tener entre 3 y 20 letras.")
+	}
+	if !nameRegexp.MatchString(name) {
+		return "", userError("El nombre solo puede tener letras (sin numeros ni simbolos).")
+	}
+	words := strings.Split(name, " ")
+	if len(words) > 3 {
+		return "", userError("El nombre puede tener como maximo 3 palabras.")
+	}
+	for i, w := range words {
+		lw := strings.ToLower(w)
+		for _, bad := range forbiddenWords {
+			if lw == bad {
+				return "", userError("Ese nombre no esta permitido.")
+			}
+		}
+		if len(w) < 2 {
+			return "", userError("Cada palabra del nombre debe tener al menos 2 letras.")
+		}
+		words[i] = strings.ToUpper(lw[:1]) + lw[1:]
+	}
+	return strings.Join(words, " "), nil
+}
+
+// CreateCharacter crea el personaje y devuelve el nombre final.
+func CreateCharacter(db *sql.DB, acc *Account, rawName string, vocation uint32) (string, error) {
+	if db == nil || acc == nil {
+		return "", errors.New("database or account is nil")
+	}
+	className, ok := CreatableVocations[vocation]
+	if !ok {
+		return "", userError("Esa clase no existe.")
+	}
+	name, err := NormalizeCharacterName(rawName)
+	if err != nil {
+		return "", err
+	}
+
+	tx, err := db.Begin()
+	if err != nil {
+		return "", err
+	}
+	defer tx.Rollback()
+
+	var count int
+	if err := tx.QueryRow("SELECT COUNT(*) FROM players WHERE account_id = ?", acc.ID).Scan(&count); err != nil {
+		return "", err
+	}
+	if count >= MaxCharactersPerAccount {
+		return "", userError("Ya tenes %d personajes. Es el maximo por cuenta.", MaxCharactersPerAccount)
+	}
+
+	var exists int
+	if err := tx.QueryRow("SELECT COUNT(*) FROM players WHERE name = ?", name).Scan(&exists); err != nil {
+		return "", err
+	}
+	if exists > 0 {
+		return "", userError("Ya existe un personaje llamado %s.", name)
+	}
+
+	var templateID int64
+	err = tx.QueryRow(
+		"SELECT id FROM players WHERE vocation = ? AND name LIKE '% Sample' ORDER BY id LIMIT 1",
+		vocation,
+	).Scan(&templateID)
+	if errors.Is(err, sql.ErrNoRows) {
+		return "", userError("Falta el personaje modelo \"%s Sample\" en la base de datos.", className)
+	}
+	if err != nil {
+		return "", err
+	}
+
+	rows, err := tx.Query(`SELECT COLUMN_NAME FROM information_schema.COLUMNS
+		WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'players' AND EXTRA NOT LIKE '%auto_increment%'
+		ORDER BY ORDINAL_POSITION`)
+	if err != nil {
+		return "", err
+	}
+	var columns []string
+	for rows.Next() {
+		var c string
+		if err := rows.Scan(&c); err != nil {
+			rows.Close()
+			return "", err
+		}
+		columns = append(columns, c)
+	}
+	rows.Close()
+	if err := rows.Err(); err != nil {
+		return "", err
+	}
+
+	// columnas que no se copian del modelo (si existen en la tabla)
+	overrides := map[string]string{
+		"name":        "?",
+		"account_id":  "?",
+		"level":       "1",
+		"experience":  "0",
+		"posx":        "0", // 0,0,0 = aparece en el templo de su ciudad
+		"posy":        "0",
+		"posz":        "0",
+		"conditions":  "''",
+		"balance":     "0",
+		"skull":       "0",
+		"skulltime":   "0",
+		"lastlogin":   "0",
+		"lastlogout":  "0",
+		"lastip":      "0",
+		"onlinetime":  "0",
+		"deletion":    "0",
+		"create_date": "UNIX_TIMESTAMP()",
+	}
+	var insertCols, selectExprs []string
+	for _, c := range columns {
+		insertCols = append(insertCols, "`"+c+"`")
+		if expr, ok := overrides[c]; ok {
+			selectExprs = append(selectExprs, expr)
+		} else {
+			selectExprs = append(selectExprs, "`"+c+"`")
+		}
+	}
+	// los parámetros "?" van en el orden de las columnas
+	var args []interface{}
+	for _, c := range columns {
+		switch c {
+		case "name":
+			args = append(args, name)
+		case "account_id":
+			args = append(args, acc.ID)
+		}
+	}
+	args = append(args, templateID)
+
+	statement := fmt.Sprintf("INSERT INTO players (%s) SELECT %s FROM players WHERE id = ?",
+		strings.Join(insertCols, ", "), strings.Join(selectExprs, ", "))
+	if _, err := tx.Exec(statement, args...); err != nil {
+		return "", err
+	}
+	if err := tx.Commit(); err != nil {
+		return "", err
+	}
+	return name, nil
+}
